<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.radiomodem.mt63">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.RadioModemMT63.Dark">

        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".ui.AdvancedSettingsActivity" android:exported="false"/>
        <activity android:name=".ui.ConnectionHelpActivity" android:exported="false"/>
        <activity android:name=".ui.StatisticsActivity" android:exported="false"/>
        <activity android:name=".ui.LogActivity" android:exported="false"/>

        <service
            android:name=".service.ModemForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|dataSync"/>
    </application>
</manifest>
